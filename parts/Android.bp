android_app {
    name: "FelicaParts",
    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.kt"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.preference_preference",
    ],

    optimize: {
        enabled: false,
    },
}
