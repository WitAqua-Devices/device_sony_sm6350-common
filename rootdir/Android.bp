prebuilt_etc {
    name: "init.sony-platform.rc",
    src: "etc/init.sony-platform.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "init.sony.rc",
    src: "etc/init.sony.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "fstab.default",
    src: "etc/fstab.default",
    vendor: true,
    ramdisk_available: true,
}

// Recovery init
prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "etc/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}

// Vendor init, imported by init as /vendor/etc/init/hw/init.qcom.rc

prebuilt_etc {
    name: "init.qcom.rc",
    src: "etc/init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "etc/init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qti.ufs.rc",
    src: "etc/init.qti.ufs.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.factory.rc",
    src: "etc/init.qcom.factory.rc",
    sub_dir: "init/hw",
    vendor: true,
}

// Owners and permissions for /dev/*.  The device does not boot without it,
// see the comment at the top of ueventd.rc.  Installed as
// /vendor/etc/ueventd.rc.
prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "ueventd.rc",
    vendor: true,
}

// Starts the 4.0 keymaster HAL.  The stock image has no rc for it, see the
// comment in etc/android.hardware.keymaster@4.0-service-qti.rc.
prebuilt_etc {
    name: "android.hardware.keymaster@4.0-service-qti.rc",
    src: "etc/android.hardware.keymaster@4.0-service-qti.rc",
    sub_dir: "init",
    vendor: true,
}

// QTI's RIL startup script, which init.qcom.rc runs and the stock image does
// not ship as a blob.  It swaps AOSP's vendor.ril-daemon, which cannot talk
// to this modem, for the vendor.qcrild blobs.
sh_binary {
    name: "init.class_main.sh",
    src: "bin/init.class_main.sh",
    vendor: true,
}

// NFC.  Loads the sn1x0 and p73 kernel modules and creates /data/vendor/nfc.
// From the stock vendor/etc/init/init.nfc.rc.
prebuilt_etc {
    name: "init.nfc.rc",
    src: "etc/init.nfc.rc",
    sub_dir: "init",
    vendor: true,
}

// Service definition for the stock NFC HAL blob, which is installed with a
// .sony suffix so the exec path matches.  The file name carries the suffix
// too, or it collides with the rc hardware/nxp/nfc/pn8x installs.
prebuilt_etc {
    name: "android.hardware.nfc@1.2-service.sony.rc",
    src: "etc/android.hardware.nfc@1.2-service.sony.rc",
    sub_dir: "init",
    vendor: true,
}
