# Start the 4.0 keymaster HAL rather than the 4.1 one the stock image starts:
# keystore2's km_compat asks for @4.0 by name and the boot stops without it.
# The service binary comes in as a blob, only the rc is missing.  Do not start
# @4.1 as well - both hold the same TZ app.

on init
    start keymaster-4-0

service keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service-qti
    class early_hal
    user system
    group system drmrpc
