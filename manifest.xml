        </interface>
        <interface>
            <name>IOmxStore</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.0::IOmx/default</fqname>
        <fqname>@1.0::IOmxStore/default</fqname>
    </hal>
    <!-- NFC.  The kernel drivers are drivers/nfc/sn1x0_{i2c,spi}, backported
