    <!-- Declare keymaster 4.0, not the 4.1 the stock manifest declares.
         keystore2's km_compat asks for
         android.hardware.keymaster@4.0::IKeymasterDevice/default by name, and
         hwservicemanager looks the requested FQName up in the manifest to
         decide which lazy service to start.  With only @4.1 listed the lookup
         misses:
           Tried to start android.hardware.keymaster@4.0::IKeymasterDevice/default
           as a lazy service, but was unable to. Usually this happens when a service
           is not installed
         keystore2 never starts, vold waits for it and the boot stops at the
         logo.  The @4.0 service binary does ship in the stock image. -->
    <hal format="hidl">
        <name>android.hardware.keymaster</name>
        <transport>hwbinder</transport>
        <version>4.0</version>
        <interface>
            <name>IKeymasterDevice</name>
            <instance>default</instance>
        </interface>
        <fqname>@4.0::IKeymasterDevice/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.media.omx</name>
