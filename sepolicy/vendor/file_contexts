# The stock HAL binaries are named differently from the ones AOSP and
# hardware/sony label, so nothing matched them.
/(vendor|odm|vendor/odm)/bin/hw/android\.hardware\.nfc@1\.2-service\.sony       u:object_r:hal_nfc_default_exec:s0
/(vendor|odm|vendor/odm)/bin/hw/android\.hardware\.secure_element@1\.2-service  u:object_r:hal_secure_element_default_exec:s0
/(vendor|odm|vendor/odm)/bin/hw/vendor\.semc\.hardware\.charger@1\.0-service    u:object_r:hal_somc_charger_default_exec:s0

# init starts the wrapper, not tad itself.
/(vendor|odm|vendor/odm)/bin/wait4tad                                          u:object_r:tad_exec:s0

# device/qcom/sepolicy_vndr's lito file_contexts labels multiimgoem_[ab] only.
/dev/block/platform/soc/1d84000\.ufshc/by-name/multiimgqti_[ab]                u:object_r:vendor_custom_ab_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/oem_[ab]                         u:object_r:oem_block_device:s0

# The amplifier calibration lives under persist/factory/audio, not the
# persist/audio that device/qcom/sepolicy_vndr labels.
/mnt/vendor/persist/factory/audio(/.*)?                                        u:object_r:vendor_persist_audio_file:s0
